# Copy to .env at the repo root (never committed). `make up` generates one
# automatically with a random database password if .env is missing.

# --- Full local stack & production (infra/compose.prod.yml) ---
POSTGRES_PASSWORD=change-me
# Production: your domain (e.g. orion.example.com) — Caddy then obtains TLS
# certificates automatically. `:80` serves plain HTTP for local use.
# List both hosts ("example.com, www.example.com") so the certificate
# covers www, and set CANONICAL_HOST for the www → apex redirect.
SITE_ADDRESS=:80
# CANONICAL_HOST=example.com
HTTP_PORT=8080
HTTPS_PORT=8443
ORION_ENV=production

# --- Accounts (workspace lot 1: magic link + approved-email gate) ---
# Public origin of the site — the base of magic links sent by email.
# ORION_PUBLIC_ORIGIN=https://example.com
# Approved emails, comma-separated. EMPTY = door closed for everyone.
# ORION_LOGIN_ALLOWLIST=you@example.com
# Dev/e2e only: no email is sent, the link is returned by the API.
# ORION_AUTH_DEV=1
# SMTP sender (production): secrets live in the SERVER .env only.
# ORION_SMTP_HOST=smtp-relay.example.com
# ORION_SMTP_PORT=587
# ORION_SMTP_USER=
# ORION_SMTP_PASSWORD=
# ORION_SMTP_FROM=no-reply@example.com

# --- Images (local `make up` builds from source; a VPS pulls from GHCR) ---
# API_IMAGE=ghcr.io/charlottecrocicchia-netizen/orion-api:latest
# WEB_IMAGE=ghcr.io/charlottecrocicchia-netizen/orion-web:latest

# --- Deployment target (infra/deploy.sh) — unset until a VPS exists ---
# DEPLOY_HOST=203.0.113.10
# DEPLOY_USER=orion
# DEPLOY_PATH=/home/orion/orion
