# Copy to .env at the repo root (never committed). `make up` generates one
# automatically with a random database password if .env is missing.

# --- Full local stack & production (infra/compose.prod.yml) ---
POSTGRES_PASSWORD=change-me
# Production: your domain (e.g. orion.example.com) — Caddy then obtains TLS
# certificates automatically. `:80` serves plain HTTP for local use.
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443
ORION_ENV=production

# --- Images (local `make up` builds from source; a VPS pulls from GHCR) ---
# API_IMAGE=ghcr.io/charlottecrocicchia-netizen/orion-api:latest
# WEB_IMAGE=ghcr.io/charlottecrocicchia-netizen/orion-web:latest

# --- Deployment target (infra/deploy.sh) — unset until a VPS exists ---
# DEPLOY_HOST=203.0.113.10
# DEPLOY_USER=orion
# DEPLOY_PATH=/home/orion/orion
